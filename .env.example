# Copy to .env for local use. Never commit real values: supply them from the
# deployment's secret store, or a local, uncommitted .env.

# Farmer registry database, using a read-only role with SELECT on the reporting
# views. Format: postgresql://<user>:<password>@<host>:5432/farmer_registry_db
DATABASE_URL=

# JSON list of origins allowed by CORS. Browsers should not call this service directly.
ALLOWED_ORIGINS=["http://localhost:3000"]

# National unit counts per geographic level, for coverage rates (JSON).
# Levels left out are reported as null. Example: {"woredas": 1138}
GEO_LEVEL_TOTALS={}
