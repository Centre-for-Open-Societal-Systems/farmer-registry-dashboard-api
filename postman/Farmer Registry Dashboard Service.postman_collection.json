  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Contract checks for every request. Keys per chart mirror CONTRACT in the service's tests/test_charts.py.",
          "const CONTRACT = {\"farmerKpis\": [\"avg_farm_size\", \"farmers_with_id\", \"farmers_with_owned_land\", \"farmers_without_id\", \"female_farmers\", \"household_heads\", \"male_farmers\", \"total_farmers\", \"total_land_size\"], \"farmersByRegion\": [\"farmers\", \"region\", \"region_code\"], \"farmersByZone\": [\"farmers\", \"zone\", \"zone_code\"], \"farmersByWoreda\": [\"farmers\", \"woreda\", \"woreda_code\"], \"farmersByKebele\": [\"farmers\", \"kebele\", \"kebele_code\"], \"farmersByFarmerId\": [\"farmers\", \"id_status\"], \"farmersByGender\": [\"farmers\", \"gender\"], \"farmersByType\": [\"farmers\", \"farming_type\"], \"farmersByAgeAndGender\": [\"age_group\", \"farmers\", \"gender\"], \"farmersByEducation\": [\"education\", \"farmers\"], \"landTenureSplit\": [\"area\", \"ownership_type\", \"parcels\"], \"registryTrendByMonth\": [\"farmers\", \"owned_area\", \"period\", \"total_area\"], \"registryCoverage\": [\"kebeles_covered\", \"kebeles_total\", \"regions_covered\", \"regions_total\", \"woredas_covered\", \"woredas_total\", \"zones_covered\", \"zones_total\"], \"farmersByRecordState\": [\"farmers\", \"record_state\"], \"farmersByPsnpStatus\": [], \"farmersByImportStatus\": []};",
          "pm.test('status is 200', () => pm.response.to.have.status(200));",
          "const path = pm.request.url.getPath();",
          "if (path === '/health') {",
          "  pm.test('health reports ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
          "} else {",
          "  const chart = path.split('/').pop();",
          "  const rows = pm.response.json();",
          "  pm.test('body is an array', () => pm.expect(rows).to.be.an('array'));",
          "  const keys = CONTRACT[chart];",
          "  if (keys) {",
          "    pm.test('rows have exactly the contract keys', () => rows.forEach(r => pm.expect(Object.keys(r).sort()).to.eql(keys)));",
          "  }",
          "}"
        ]
      }
    }
